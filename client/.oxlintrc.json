{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "plugins": [
    "react",
    "jsx-a11y",
    "import"
  ],
  "env": {
    "browser": true
  },
  "overrides": [
    {
      "files": [
        "vite.config.js"
      ],
      "env": {
        "browser": false,
        "node": true
      }
    }
  ],
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/exhaustive-effect-dependencies": "off",
    "import/no-unassigned-import": "off"
  }
}
