{
  "name": "server",
  "type": "module",
  "main": "src/www.js",
  "scripts": {
    "dev": "tsx watch src/www.ts",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/www.js",
    "test": "tsx --test src/**/*.test.ts",
    "provision:reviewer": "tsx src/provisionReviewer.ts",
    "lint": "oxlint src",
    "format": "prettier --write src prettier.config.mjs",
    "format:check": "prettier --check src prettier.config.mjs"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg-promise": "^12.7.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15"
  }
}
